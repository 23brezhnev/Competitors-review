# ---- Database ----
# Local dev: sqlite:///./monitor.db
# Prod (Supabase): postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./monitor.db

# ---- Admin ----
SECRET_KEY=change-me-to-a-long-random-string

# ---- VK ----
VK_SERVICE_TOKEN=

# ---- Telegram (reading channels via Telethon) ----
TG_API_ID=
TG_API_HASH=
TG_SESSION=tg_session

# ---- Telegram bot (sending the report) ----
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- DeepSeek (summarization) ----
DEEPSEEK_API_KEY=
