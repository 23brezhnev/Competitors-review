# ---- Database ----
# Local dev: sqlite:///./monitor.db
# Prod (Supabase): postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./monitor.db

# ---- Admin ----
SECRET_KEY=change-me-to-a-long-random-string

# ---- VK ----
VK_SERVICE_TOKEN=

# Reading public Telegram channels needs no credentials (t.me/s web preview).

# ---- Telegram bot (sending the report) ----
# Global fallback; each product can define its own bot in the admin.
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- DeepSeek (summarization) ----
DEEPSEEK_API_KEY=
